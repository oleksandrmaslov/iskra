<Window
    x:Class="Iskra.Desktop.DeviceFlowWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="560"
    Height="430"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="#FFF4F6F9"
    mc:Ignorable="d">

  <Window.Styles>
    <!-- Same on-dark button treatment as the MainWindow header bar. Without an
         explicit style, Fluent's light-theme button fill is a translucent white
         that composites down over the dark user-code panel and leaves
         near-black label text on dark navy (measured 1.21:1). Fluent applies
         its hover and pressed brushes to the template part, so every state is
         pinned there. -->
    <Style Selector="Button.on-dark">
      <Setter Property="Foreground" Value="#FFF2F5F9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.on-dark /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF3C4350" />
      <Setter Property="BorderBrush" Value="#FF5A6472" />
      <Setter Property="TextElement.Foreground" Value="#FFF2F5F9" />
    </Style>
    <Style Selector="Button.on-dark:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF4C5563" />
      <Setter Property="BorderBrush" Value="#FF76808F" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.on-dark:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF2A303A" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.on-dark:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF33383F" />
      <Setter Property="TextElement.Foreground" Value="#FF8A929C" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="28,24" Spacing="14">
    <TextBlock x:Name="TitleText"
               FontSize="21" FontWeight="SemiBold" Foreground="#FF162033"
               TextWrapping="Wrap" />

    <TextBlock x:Name="Step1Text" Foreground="#FF5F6B7A" TextWrapping="Wrap" />

    <Border Background="White" BorderBrush="#FFD7DEE8" BorderThickness="1"
            CornerRadius="8" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <SelectableTextBlock Grid.Column="0" x:Name="VerificationUrl"
                             VerticalAlignment="Center" FontSize="15"
                             Foreground="#FF1B5FCC" TextWrapping="Wrap" />
        <Button Grid.Column="1" x:Name="OpenBrowserButton" Padding="14,6"
                Click="OpenBrowser_Click" />
      </Grid>
    </Border>

    <TextBlock x:Name="Step2Text" Foreground="#FF5F6B7A" TextWrapping="Wrap" />

    <Border Background="#FF162033" CornerRadius="8" Padding="18,14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <SelectableTextBlock Grid.Column="0" x:Name="UserCode"
                             FontSize="38" FontWeight="Bold" Foreground="White"
                             FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="CopyCodeButton" Classes="on-dark" Padding="14,6"
                VerticalAlignment="Center" Click="CopyCode_Click" />
      </Grid>
    </Border>

    <TextBlock x:Name="StatusText" Foreground="#FF5F6B7A" TextWrapping="Wrap" MinHeight="34" />

    <Button x:Name="CancelButton" HorizontalAlignment="Right" Padding="18,7"
            Click="Cancel_Click" />
  </StackPanel>
</Window>
