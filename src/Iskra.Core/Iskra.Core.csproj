<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Unsigned catalogs are compiled out of Release by default. Maintainers
         can build an explicitly labelled lab binary with
         -p:IskraEnableLabCatalogs=true; the runtime environment switch is
         only a second confirmation inside such a build. -->
    <IskraEnableLabCatalogs Condition="'$(IskraEnableLabCatalogs)' == '' and '$(Configuration)' == 'Debug'">true</IskraEnableLabCatalogs>
    <IskraEnableLabCatalogs Condition="'$(IskraEnableLabCatalogs)' == ''">false</IskraEnableLabCatalogs>
    <DefineConstants Condition="'$(IskraEnableLabCatalogs)' == 'true'">$(DefineConstants);ISKRA_LAB_CATALOGS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.28" />
    <!-- Microsoft.Data.Sqlite's broad dependency otherwise resolves the legacy
         2.1.x native bundle (SQLite before the CVE-2025-6965 fix). Keep the
         native runtime explicitly pinned to the maintained 3.x bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iskra.Core.Tests" />
  </ItemGroup>

</Project>
