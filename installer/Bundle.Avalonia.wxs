<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Setup EXE for the Avalonia frontend. Carries the same SHA-256-pinned Arm GNU
    Toolchain as the WPF setup, so a bare station needs no other download.

    Its UpgradeCode differs from Bundle.wxs: the two bundles must be able to
    coexist in Add/Remove Programs, and installing this one must never be
    treated as an upgrade of the production WPF setup.
  -->
  <Bundle Name="Iskra Avalonia"
          Manufacturer="Oleksandr Maslov"
          Version="$(var.AppVersion)"
          UpgradeCode="2B0E62A2-6727-4DE5-A3D7-545F85FA47C6"
          Compressed="yes"
          IconSourceFile="$(var.SolutionDir)\installer\assets\iskra.ico"
          DisableModify="button">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LogoFile="$(var.SolutionDir)\installer\assets\logo.png"
          LicenseUrl=""
          ShowVersion="yes"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <bal:Condition Condition="VersionNT64 &gt;= v10.0"
                   Message="Потрібна Windows 10/11 x64. Встановлення Iskra Avalonia зупинено." />

    <!-- Skip the bundled Arm MSI when a supported gdb is already present —
         including the copy the WPF setup may have installed earlier. -->
    <util:FileSearch Id="ArmGdb15Search"
                     Variable="ArmGdb15Exists"
                     Result="exists"
                     Path="[ProgramFiles64Folder]Arm\GNU Toolchain mingw-w64-i686-arm-none-eabi\bin\arm-none-eabi-gdb.exe" />
    <util:FileSearch Id="ArmGdb15X86Search"
                     Variable="ArmGdb15X86Exists"
                     Result="exists"
                     Path="[ProgramFilesFolder]Arm\GNU Toolchain mingw-w64-i686-arm-none-eabi\bin\arm-none-eabi-gdb.exe" />
    <util:FileSearch Id="ArmGdbLegacyArm15Search"
                     Variable="ArmGdbLegacyArm15Exists"
                     Result="exists"
                     Path="[ProgramFiles64Folder]Arm GNU Toolchain arm-none-eabi\15.2 rel1\bin\arm-none-eabi-gdb.exe" />
    <util:FileSearch Id="ArmGdbLegacyArm15X86Search"
                     Variable="ArmGdbLegacyArm15X86Exists"
                     Result="exists"
                     Path="[ProgramFilesFolder]Arm GNU Toolchain arm-none-eabi\15.2 rel1\bin\arm-none-eabi-gdb.exe" />
    <util:FileSearch Id="ArmGdbLegacyArm14Search"
                     Variable="ArmGdbLegacyArm14Exists"
                     Result="exists"
                     Path="[ProgramFilesFolder]Arm GNU Toolchain arm-none-eabi\14.3 rel1\bin\arm-none-eabi-gdb.exe" />
    <util:FileSearch Id="ArmGdbLegacyX86Search"
                     Variable="ArmGdbLegacyX86Exists"
                     Result="exists"
                     Path="[ProgramFilesFolder]GNU Arm Embedded Toolchain\10 2021.10\bin\arm-none-eabi-gdb.exe" />
    <util:FileSearch Id="ArmGdbLegacyArmX86Search"
                     Variable="ArmGdbLegacyArmX86Exists"
                     Result="exists"
                     Path="[ProgramFilesFolder]Arm GNU Toolchain arm-none-eabi\10 2021.10\bin\arm-none-eabi-gdb.exe" />

    <Chain>
      <!-- Third-party prerequisite, shared with the WPF product. Permanent, so
           removing Iskra Avalonia never strips the toolchain out from under a
           WPF station that is still flashing production. -->
      <MsiPackage Id="ArmGnuToolchain"
                  SourceFile="$(var.ArmToolchainMsi)"
                  DisplayName="Arm GNU Toolchain (arm-none-eabi)"
                  InstallCondition="NOT ArmGdb15Exists AND NOT ArmGdb15X86Exists AND NOT ArmGdbLegacyArm15Exists AND NOT ArmGdbLegacyArm15X86Exists AND NOT ArmGdbLegacyArm14Exists AND NOT ArmGdbLegacyX86Exists AND NOT ArmGdbLegacyArmX86Exists"
                  Permanent="yes"
                  Visible="yes"
                  Vital="yes">
        <MsiProperty Name="EULA" Value="1" />
      </MsiPackage>

      <MsiPackage Id="IskraAvaloniaMsi"
                  SourceFile="$(var.IskraMsi)"
                  DisplayName="Iskra Avalonia"
                  ForcePerMachine="yes"
                  Visible="no"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
